# Server-only key. Never expose this with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=""
# Optional model overrides; documented defaults are used when empty.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Set your actual public https origin before a production build.
# Canonicals, social-image URLs, robots sitemap, and sitemap.xml use it.
APP_URL=""

# PUBLIC-LAUNCH LEGAL IDENTITY: configure with verified operator records.
# These are server-side values displayed on legal pages (not secrets).
# Leave unset rather than inventing a company identity; legal pages flag omissions.
LEGAL_OPERATOR_NAME=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
LEGAL_SERVICE_ADDRESS=""
LEGAL_REGISTRATION_NUMBER=""
