{
  "name": "bidcraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "oxlint .",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "anatomy:build": "node scripts/build-bid-anatomy.mjs",
    "anatomy:audit": "node scripts/build-bid-anatomy.mjs --audit",
    "anatomy:verify": "node scripts/verify-bid-anatomy.mjs",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.5.0",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.34.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
